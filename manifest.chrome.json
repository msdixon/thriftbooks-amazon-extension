{
  "manifest_version": 3,
  "name": "ThriftBooks Link on Amazon",
  "version": "0.2.0",
  "description": "Adds a ThriftBooks search link with live pricing on Amazon book pages when an ISBN match is found.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.amazon.com/*"],
  "optional_host_permissions": ["*://*.thriftbooks.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*"],
      "js": ["content_script.js"],
      "css": ["ui/injected.css"],
      "run_at": "document_end"
    }
  ]
}
