{
  "manifest_version": 3,
  "name": "ThriftBooks Link on Amazon",
  "version": "0.1.0",
  "description": "Adds a ThriftBooks search link on Amazon book pages when an ISBN match is found.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.amazon.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*"],
      "js": ["content_script.js"],
      "css": ["ui/injected.css"],
      "run_at": "document_end"
    }
  ]
}
